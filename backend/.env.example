APP_NAME=NorthByte
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:4173
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
DB_DATABASE=../private/northbyte.sqlite
DB_FOREIGN_KEYS=true
SESSION_DRIVER=file
SESSION_COOKIE=northbyte_admin_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:4173,localhost:4173
CACHE_STORE=file
QUEUE_CONNECTION=database
LOG_CHANNEL=single
LOG_LEVEL=warning
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=NorthByte
ADMIN_MAIL_NOTIFICATIONS=false
NODE_BINARY=node
ALLOW_ZIP_UPLOADS=false
ATTACHMENT_MAX_MB=20
ATTACHMENT_HARD_MAX_MB=50
